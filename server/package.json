{
  "name": "brief-server",
  "private": true,
  "type": "module",
  "description": "Brief server side. No dependency: run with Node 24 (type stripping).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test triage/ scripts/",
    "check-live": "node triage/check-live.ts",
