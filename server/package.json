{
  "name": "brief-server",
  "private": true,
  "type": "module",
  "description": "Brief server side. No dependency: run with Node 24 (type stripping).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test triage/ scripts/",
    "check-live": "node triage/check-live.ts",
    "seed": "node scripts/seed-demo.ts",
    "seed:dry": "node scripts/seed-demo.ts --dry-run",
    "typecheck": "../node_modules/.bin/tsc -p tsconfig.json",
    "test:py": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "fake": "node scripts/fake-upstreams.ts",
    "seed-label:dry": "python3 scripts/seed_label.py --dry-run"
  }
}
