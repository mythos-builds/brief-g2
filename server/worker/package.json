{
  "name": "brief-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Brief backend: one Cloudflare Worker (static app, JSON API, Google sign-in with a 6-digit pairing code) on D1.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --ip 127.0.0.1",
    "build": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.7.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
}
