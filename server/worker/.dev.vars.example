# Local `wrangler dev` only. Copy to .dev.vars (git-ignored) and keep these DUMMY values: they reach no real service.
# Day 3: every upstream is job B's local fake (app/server/scripts/fake-upstreams.ts, 127.0.0.1:8799), which plays Google
# and the model. The five base addresses below are read ONLY because ENV is "dev"; any other ENV ignores them.
ENV="dev"
# The fake's client id and account (its id_token says aud "dev-client-id", email "demo@example.com").
GOOGLE_CLIENT_ID="dev-client-id"
GOOGLE_CLIENT_SECRET="dummy-client-secret"
# base64 of 32 bytes; this one is all zeros, a dummy
TOKEN_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
ALLOWED_ACCOUNTS="demo@example.com"
# The local Worker's own callback (the fake never redirects; you call /oauth/callback yourself, README « Local run »).
OAUTH_REDIRECT_URI="http://127.0.0.1:8787/oauth/callback"
# A dummy model key: the fake ignores it, but the sync triages only when a key is set.
OPENROUTER_API_KEY="dummy-model-key-not-real"
GOOGLE_TOKEN_URL="http://127.0.0.1:8799/token"
GOOGLE_REVOKE_URL="http://127.0.0.1:8799/revoke"
GMAIL_BASE="http://127.0.0.1:8799"
CALENDAR_BASE="http://127.0.0.1:8799"
MODEL_BASE="http://127.0.0.1:8799"
# Day 4: the real send, ON in dev only: every Google call goes to the fake above, which keeps what it gets (GET /_sent).
# wrangler.toml keeps "off" for production; any value but exactly "on" is off.
REAL_SEND="on"
SEND_DAILY_CAP="20"
# Day 5: « Speak a change ». Workers AI = the same fake (its /ai/run/<model> paths), read ONLY because ENV is "dev": a dev
# Worker never uses the [ai] binding (it always reaches the live service; wrangler.local.toml has no such block).
# VOICE: exactly "on" = offered; anything else = off (the speak route answers 404, the items answer says "voice":false).
AI_BASE="http://127.0.0.1:8799"
VOICE="on"
VOICE_DAILY_NEURONS="3000"
