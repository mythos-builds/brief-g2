# Even Hub simulator jail: keeps WebKitGTK + Xvfb off the host. Binary is bind-mounted read-only.
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-0 xvfb xauth ca-certificates fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m sim
USER sim
WORKDIR /home/sim
